# =====================================================
# aki_sys 后端环境变量(生产)
#
# 安装位置: /etc/aki-admin/aki-admin.env
# 权限必须 600,属主 root(里面有数据库密码和 JWT 密钥)
#   sudo install -m 600 -o root -g root aki-admin.env /etc/aki-admin/aki-admin.env
#
# 改完必须重启服务才生效:
#   sudo systemctl restart aki-admin
#
# 注意:systemd 的 EnvironmentFile 不做变量展开、不支持 export 关键字、
#       值也不要加引号(引号会被当成值的一部分传给 Java)。
# =====================================================

# ---------- 服务端口 ----------
AKI_PORT=8080

# ---------- MySQL ----------
AKI_DB_HOST=127.0.0.1
AKI_DB_PORT=3306
AKI_DB_NAME=aki_sys
# 与 server-init.sh 创建的专用账号保持一致(root 也行,但不推荐)
AKI_DB_USERNAME=aki
# 密码会被拼进 JDBC URL,又要经 systemd 的 EnvironmentFile 解析,所以只能用:
#   字母 数字 . _ @ # % ^ + = -
# 禁用:空格 : / ? \ $ ' " 和中文
#   - \ 和 $ 是 systemd 的转义/展开字符,密码会被悄悄改写(反斜杠被吃掉、$ 被展开)
#   - : / ? # 是 URL 特殊字符(注:# 在值里其实是安全的,这里为了少一个变量一起禁掉)
# 不要在这行做 URL 编码:@ 属于允许字符,写成 %40 反而会让密码对不上。
# 生成随机密码:openssl rand -hex 24   (hex 只有 0-9a-f,天然满足要求)
AKI_DB_PASSWORD=CHANGE_ME

# ---------- Redis ----------
AKI_REDIS_HOST=127.0.0.1
AKI_REDIS_PORT=6379
# 服务器 Redis 务必设密码(见 server-init.sh 里的 requirepass 说明)
AKI_REDIS_PASSWORD=CHANGE_ME
AKI_REDIS_DB=0

# ---------- JWT ----------
# 生成命令:openssl rand -base64 48
# 换了密钥 = 所有已登录用户的 token 立即失效,这是预期行为。
AKI_JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
AKI_JWT_EXPIRE_SECONDS=28800

# ---------- 站点访客注册 ----------
# true  = 开放注册(默认)
# false = 关闭注册接口。公开注册被机器人刷爆时改成 false 并重启服务即可,
#         不必改代码重新发版;已有访客账号不受影响,仍能正常登录。
AKI_REGISTER_ENABLED=true
