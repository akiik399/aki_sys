# 统一换行符,避免跨平台协作时把整个文件标记成"全部改动"
* text=auto eol=lf

# Shell 脚本必须是 LF:CRLF 会让 Linux 上的 bash 报
#   /bin/bash^M: bad interpreter: No such file or directory
*.sh   text eol=lf

# PowerShell 脚本保持 LF(内容本身需为 UTF-8 with BOM,见 deploy/README.md)
*.ps1  text eol=lf
*.bat  text eol=crlf

# 二进制产物不要做换行转换
*.jar  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
